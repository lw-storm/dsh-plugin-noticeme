{
    "name":  "dsh-plugin-noticeme",
    "version":  "2.2.0",
    "description":  "Notify me when DSH needs me: desktop notification (with tab-title fallback) when an approval prompt or an ask-user-question card appears while the page is in the background.",
    "type":  "module",
    "main":  "lib/index.js",
    "license":  "MIT",
    "keywords":  [
                     "deepseek",
                     "harness",
                     "dsh",
                     "dsh-plugin",
                     "notification",
                     "desktop-notify",
                     "approval"
                 ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-connection",
                                              "@deepseek-ai/dsh-client-runtime",
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-settings"
                                          ],
                               "platform":  "web"
                           }
            },
    "exports":  {
                    ".":  {
                              "default":  "./lib/index.js"
                          },
                    "./client":  "./client/client.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "client",
                  "cordis.patch.yml"
              ],
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.1",
                             "@deepseek-ai/dsh-tools":  "^0.1.0-rc.6"
                         },
    "packageManager":  "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}